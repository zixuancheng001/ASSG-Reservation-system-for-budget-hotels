@model IEnumerable<Demo.Models.WishlistItem>
@{
    ViewData["Title"] = "My Wishlist";
}

<div style="min-height:calc(100vh - 70px); background:#f7f7fb; padding:40px 6%;">
    <div style="max-width:1000px; margin:auto;">
        <h1 style="color:#202033; margin-top:0;">♥ My Wishlist</h1>
        <p style="color:#777;">Keep rooms here and book them when your dates are confirmed.</p>

        @if (!Model.Any())
        {
            <div style="background:white; border-radius:18px; padding:40px; text-align:center; box-shadow:0 8px 25px rgba(0,0,0,.05);">
                <h3>Your wishlist is empty.</h3>
                <a asp-controller="Catalog" asp-action="Index" style="color:#655bd0; font-weight:600;">Browse rooms</a>
            </div>
        }
        else
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:20px;">
                @foreach (var item in Model)
                {
                    <article style="background:white; border-radius:18px; overflow:hidden; box-shadow:0 8px 25px rgba(0,0,0,.05);">
                        @if (!string.IsNullOrWhiteSpace(item.Product?.PhotoURL))
                        {
                            <img src="/photos/@item.Product.PhotoURL" alt="@item.Product.Name" style="width:100%; height:180px; object-fit:cover;" />
                        }
                        <div style="padding:18px;">
                            <h3 style="margin:0 0 8px; color:#202033;">@item.Product?.Name</h3>
                            <p style="margin:0 0 14px; color:#655bd0; font-weight:700;">RM @item.Product?.Price.ToString("N2") / night</p>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" style="display:inline-block; color:#655bd0; font-weight:600; margin-right:14px;">View room</a>
                            <form asp-action="Remove" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.WishlistItemId" />
                                <button type="submit" style="border:0; background:none; color:#d94350; cursor:pointer;">Remove</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
