@{
    ViewBag.Title = "Welcome | Budget Hotel";
}

<div class="page-card" style="text-align: center;">
    <div style="font-size: 2.5rem; margin-bottom: 10px;">🏨</div>

    <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 10px; color: #111;">Welcome to Budget Hotel</h1>

    <p style="color: #666; font-size: 0.95rem; line-height: 1.5; margin-bottom: 25px;">
        Affordable comfort for your next stay. Book your perfect room in just a few clicks!
    </p>

    <!-- Main CTA Button -->
    <div style="margin-bottom: 20px;">
        <a asp-controller="GuestCatalog" asp-action="Index" style="display: block; width: 100%; padding: 12px 0; background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%); color: #222; text-decoration: none; font-weight: 600; border-radius: 25px; transition: opacity 0.2s;">
            🔍 Browse Rooms
        </a>
    </div>

    <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;" />

    <p style="font-size: 0.85rem; color: #888; margin-bottom: 15px;">Already have an account or new here?</p>

    <!-- Secondary Login / Register Buttons -->
    <div style="display: flex; gap: 10px; justify-content: center;">
        <a href="/Account/Login" style="flex: 1; padding: 10px 0; background-color: #1a1a1a; color: #fff; text-decoration: none; font-weight: 600; border-radius: 25px; font-size: 0.9rem;">
            Login
        </a>
        <a href="/Account/Register" style="flex: 1; padding: 10px 0; background-color: #f0f0f0; color: #333; text-decoration: none; font-weight: 600; border-radius: 25px; font-size: 0.9rem;">
            Register
        </a>
    </div>
</div>