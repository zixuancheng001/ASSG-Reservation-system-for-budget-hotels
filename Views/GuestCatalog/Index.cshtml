@model List<Product>

@{
    ViewData["Title"] = "Browse Rooms";
}

<style>
    .catalog-page {
        min-height: calc(100vh - 70px);
        background: #f7f7fb;
        padding: 45px 6%;
    }

    .catalog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 16px;
    }

        .catalog-header h1 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            color: #202033;
        }

        .catalog-header p {
            margin-top: 8px;
            color: #777;
            font-size: 15px;
        }

    .header-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-login {
        background: linear-gradient(135deg, #7067d8, #a86fd3);
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-login:hover {
            color: white;
            transform: translateY(-2px);
        }

    .btn-register {
        background: white;
        color: #7067d8;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: 2px solid #c4c0f0;
        transition: 0.2s;
    }

        .btn-register:hover {
            background: #f0effd;
            color: #5e54c8;
        }

    /* Guest Notice */

    .guest-notice {
        background: #f0effd;
        border: 1px solid #d4d0f8;
        border-radius: 14px;
        padding: 14px 20px;
        margin-bottom: 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .guest-notice-text {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: #5e54c8;
        font-weight: 500;
    }

    .guest-notice-actions {
        display: flex;
        gap: 10px;
    }

    .notice-btn-login {
        background: linear-gradient(135deg, #7067d8, #a86fd3);
        color: white;
        padding: 8px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s;
    }

        .notice-btn-login:hover {
            color: white;
            opacity: 0.9;
        }

    .notice-btn-register {
        background: white;
        color: #7067d8;
        padding: 7px 16px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #c4c0f0;
        transition: 0.2s;
    }

        .notice-btn-register:hover {
            background: #f0effd;
            color: #5e54c8;
        }

    /* Search Area */

    .search-card {
        background: white;
        padding: 22px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        margin-bottom: 30px;
    }

    .search-form {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .search-input {
        flex: 1;
        padding: 13px 16px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        outline: none;
    }

        .search-input:focus {
            border-color: #756bd8;
        }

    .category-select {
        padding: 13px 16px;
        border: 1px solid #ddd;
        border-radius: 10px;
        min-width: 190px;
        font-size: 15px;
        background: white;
    }

    .search-button {
        padding: 13px 24px;
        border: none;
        border-radius: 10px;
        background: #756bd8;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

        .search-button:hover {
            background: #6258c7;
        }

    /* Room Grid */

    .room-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .room-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        transition: 0.25s;
        display: flex;
        flex-direction: column;
    }

        .room-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.10);
        }

    .room-image {
        width: 100%;
        height: 185px;
        object-fit: cover;
        display: block;
    }

    .room-image-placeholder {
        width: 100%;
        height: 185px;
        background: #eeeef5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999;
    }

    .room-content {
        padding: 18px 20px 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .room-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .room-name {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #222;
    }

    .room-id {
        color: #888;
        font-size: 13px;
        margin-top: 5px;
    }

    .status {
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .available {
        background: #e8f8ef;
        color: #179957;
    }

    .unavailable {
        background: #fdebec;
        color: #d94350;
    }

    .room-info {
        margin-top: 18px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .info-item {
        font-size: 14px;
        color: #777;
    }

        .info-item strong {
            display: block;
            color: #333;
            margin-top: 3px;
        }

    .price {
        margin-top: 18px;
        font-size: 22px;
        font-weight: 700;
        color: #655bd0;
    }

        .price span {
            font-size: 13px;
            color: #888;
            font-weight: 400;
        }

    .details-button {
        display: block;
        text-align: center;
        margin-top: 18px;
        padding: 12px;
        border-radius: 10px;
        background: #f0effd;
        color: #5e54c8;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .details-button:hover {
            background: #e4e2fb;
            color: #4e45b6;
        }

    .empty-card {
        background: white;
        border-radius: 18px;
        padding: 50px;
        text-align: center;
        color: #777;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    /* Mobile */

    @@media (max-width: 1100px) {
        .room-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .catalog-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .search-form {
            flex-direction: column;
            align-items: stretch;
        }

        .category-select,
        .search-button {
            width: 100%;
        }

        .room-grid {
            grid-template-columns: 1fr;
        }

        .guest-notice {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>


<div class="catalog-page">

    <!-- Header -->

    <div class="catalog-header">

        <div>
            <h1>Browse Rooms</h1>
            <p>Find the perfect room for your stay</p>
        </div>

        <div class="header-actions">

            <a asp-controller="Account"
               asp-action="Login"
               class="btn-login">
                Login to Book
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn-register">
                Register
            </a>

        </div>

    </div>


    <!-- Guest Notice -->

    <div class="guest-notice">

        <div class="guest-notice-text">
            <span>🔒</span>
            <span>You're browsing as a guest. Login or register to make a booking.</span>
        </div>

        <div class="guest-notice-actions">

            <a asp-controller="Account"
               asp-action="Login"
               class="notice-btn-login">
                Login
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="notice-btn-register">
                Register
            </a>

        </div>

    </div>


    <!-- Search & Filter -->

    <div class="search-card">

        <form method="get"
              asp-action="Index"
              class="search-form">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="search-input"
                   placeholder="Search rooms by name..." />

            <select name="categoryId"
                    class="category-select">

                <option value="">All Categories</option>

                @foreach (var category in ViewBag.Categories)
                {
                    if (ViewBag.CategoryId == category.CategoryId)
                    {
                        <option value="@category.CategoryId" selected>
                            @category.Name
                        </option>
                    }
                    else
                    {
                        <option value="@category.CategoryId">
                            @category.Name
                        </option>
                    }
                }

            </select>

            <button type="submit"
                    class="search-button">
                Search
            </button>

        </form>

    </div>


    <!-- Room List -->

    @if (Model.Count == 0)
    {
        <div class="empty-card">

            <h2>No rooms found</h2>

            <p>
                Try another room name or category.
            </p>

        </div>
    }
    else
    {
        <div class="room-grid">

            @foreach (var product in Model)
            {
                <div class="room-card">

                    <!-- Photo -->

                    @if (!string.IsNullOrEmpty(product.PhotoURL))
                    {
                        <img src="/photos/@product.PhotoURL"
                             class="room-image"
                             alt="@product.Name" />
                    }
                    else
                    {
                        <div class="room-image-placeholder">
                            No Photo
                        </div>
                    }


                    <div class="room-content">

                        <!-- Room Name + Status -->

                        <div class="room-top">

                            <div>
                                <h2 class="room-name">
                                    @product.Name
                                </h2>

                                <div class="room-id">
                                    @product.ProductId
                                </div>
                            </div>

                            @if (product.IsAvailable)
                            {
                                <span class="status available">
                                    ● Available
                                </span>
                            }
                            else
                            {
                                <span class="status unavailable">
                                    ● Unavailable
                                </span>
                            }

                        </div>


                        <!-- Room Information -->

                        <div class="room-info">

                            <div class="info-item">
                                Category
                                <strong>
                                    @product.Category?.Name
                                </strong>
                            </div>

                            <div class="info-item">
                                Capacity
                                <strong>
                                    👤 @product.Capacity Guests
                                </strong>
                            </div>

                        </div>


                        <!-- Price -->

                        <div class="price">
                            RM @product.Price.ToString("0.00")
                            <span>/ night</span>
                        </div>


                        <!-- Details -->

                        <a asp-action="Details"
                           asp-route-id="@product.ProductId"
                           class="details-button">
                            View Room Details →
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>
