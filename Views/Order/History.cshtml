@model IEnumerable<Demo.Models.Order>

@{
    ViewData["Title"] = "My Booking History";
}

<style>
    .history-container {
        min-height: calc(100vh - 70px);
        background: #f7f7fb;
        padding: 40px 6%;
    }

    .history-card {
        background: white;
        border-radius: 20px;
        max-width: 950px;
        margin: 0 auto;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f0f0f0;
    }

        .history-header h2 {
            margin: 0;
            font-size: 24px;
            color: #222;
        }

    .order-item-card {
        border: 1px solid #eaeaea;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.2s ease;
    }

        .order-item-card:hover {
            border-color: #655bd0;
            box-shadow: 0 4px 15px rgba(101, 91, 208, 0.08);
        }

    .order-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 12px;
        border-bottom: 1px dashed #eee;
        margin-bottom: 15px;
    }

    .order-id {
        font-weight: 700;
        color: #333;
        font-size: 16px;
    }

    .order-date {
        color: #888;
        font-size: 13px;
        margin-left: 10px;
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        background: #e8f8f0;
        color: #179957;
    }

    .room-preview {
        display: flex;
        gap: 15px;
        align-items: center;
        margin-bottom: 10px;
    }

    .room-img {
        width: 70px;
        height: 55px;
        object-fit: cover;
        border-radius: 8px;
    }

    .room-placeholder {
        width: 70px;
        height: 55px;
        background: #f0f0f5;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 11px;
    }

    .room-info h5 {
        margin: 0 0 4px 0;
        font-size: 16px;
        color: #333;
    }

    .room-info p {
        margin: 0;
        font-size: 13px;
        color: #777;
    }

    .order-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        padding-top: 12px;
        border-top: 1px solid #f9f9f9;
    }

    .total-price {
        font-size: 16px;
        font-weight: 700;
        color: #655bd0;
    }

    .btn-view-details {
        padding: 8px 18px;
        background: #f0effd;
        color: #5e54c8;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-view-details:hover {
            background: #655bd0;
            color: white;
        }

    .empty-history {
        text-align: center;
        padding: 50px 20px;
        color: #777;
    }
</style>

<div class="history-container">
    <div class="history-card">

        <div class="history-header">
            <h2>📅 My Booking History</h2>
            <a asp-controller="Catalog" asp-action="Index" class="btn-view-details">+ Book New Room</a>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-history">
                <p style="font-size: 18px;">You haven't made any room reservations yet.</p>
                <a asp-controller="Catalog" asp-action="Index" class="btn-view-details" style="display: inline-block; margin-top: 10px;">Explore Rooms</a>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div class="order-item-card">
                    <!-- Order Top Info -->
                    <div class="order-top">
                        <div>
                            <span class="order-id">Order #@order.OrderId</span>
                            <span class="order-date">Placed on @order.OrderDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                        <span class="status-badge"
                              style="@(order.Status == "Cancelled" ? "background:#fdebec; color:#d94350;" : order.Status == "Pending" ? "background:#fff8e6; color:#c08000;" : "")">
                            @order.Status
                        </span>
                    </div>

                    <!-- Items List -->
                    @foreach (var item in order.Items)
                    {
                        var nights = (item.CheckOutDate - item.CheckInDate).Days;

                        <div class="room-preview">
                            @if (!string.IsNullOrEmpty(item.Product?.PhotoURL))
                            {
                                <img src="/photos/@item.Product.PhotoURL" class="room-img" alt="@item.Product.Name" />
                            }
                            else
                            {
                                <div class="room-placeholder">No Photo</div>
                            }

                            <div class="room-info">
                                <h5>@(item.Product?.Name ?? "Room #" + item.ProductId)</h5>
                                <p>
                                    📅 Check-in: @item.CheckInDate.ToString("dd MMM yyyy")
                                    → Check-out: @item.CheckOutDate.ToString("dd MMM yyyy")
                                    (@(nights > 0 ? nights : 1) night(s))
                                </p>
                            </div>
                        </div>
                    }

                    <!-- Order Bottom Action -->
                    <div class="order-bottom">
                        <div class="total-price">
                            Total: RM @order.TotalAmount.ToString("0.00")
                        </div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            @* Show Cancel button if order is not yet cancelled AND check-in hasn't passed *@
                            @if (order.Status != "Cancelled")
                            {
                                bool canCancel = order.Items.Any() && order.Items.All(i => i.CheckInDate.Date > DateTime.Today);
                                if (canCancel)
                                {
                                    <form asp-action="CancelOrder" asp-route-id="@order.OrderId" method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel order #@order.OrderId?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-view-details"
                                                style="background: #fdebec; color: #d94350;">
                                            Cancel Order
                                        </button>
                                    </form>
                                }
                                else if (order.Items.Any())
                                {
                                    <span style="font-size: 13px; color: #d94350;">check-in date reached</span>
                                }
                            }
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="btn-view-details">
                                View Receipt &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        }

    </div>
</div>