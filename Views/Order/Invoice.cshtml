@model Demo.Models.Order

@{
    Layout = null; 
    ViewData["Title"] = $"Invoice_#{Model.OrderId:D6}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f6f8;
            margin: 0;
            padding: 40px 20px;
            color: #333;
        }

        .invoice-box {
            max-width: 800px;
            margin: auto;
            padding: 40px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .company-details h2 {
            margin: 0;
            color: #655bd0;
            font-size: 28px;
        }

        .company-details p {
            margin: 5px 0 0 0;
            color: #777;
            font-size: 14px;
        }

        .invoice-title {
            text-align: right;
        }

            .invoice-title h1 {
                margin: 0;
                font-size: 32px;
                color: #222;
                letter-spacing: 1px;
            }

        .invoice-details {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            background: #f9f9fc;
            padding: 20px;
            border-radius: 8px;
        }

        .details-block p {
            margin: 4px 0;
            font-size: 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            margin-bottom: 30px;
        }

        th {
            background-color: #655bd0;
            color: #ffffff;
            padding: 12px;
            font-size: 14px;
            font-weight: 600;
        }

        td {
            padding: 14px 12px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        .total-section {
            display: flex;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .total-table {
            width: 300px;
        }

            .total-table td {
                border: none;
                padding: 6px 12px;
            }

            .total-table .grand-total {
                font-size: 18px;
                font-weight: bold;
                color: #655bd0;
                border-top: 2px solid #222;
            }

        .toolbar {
            max-width: 800px;
            margin: 0 auto 20px auto;
            display: flex;
            justify-content: space-between;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            font-size: 14px;
        }

        .btn-download {
            background-color: #655bd0;
            color: white;
        }

        .btn-back {
            background-color: #e0e0e0;
            color: #333;
        }

        @@media print {
            body

        {
            background: white;
            padding: 0;
        }

        .toolbar {
            display: none !important;
        }

        .invoice-box {
            box-shadow: none;
            padding: 0;
            max-width: 100%;
        }

        }
    </style>
</head>
<body>

    <div class="toolbar">
        <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-back">← Back to Order</a>
        <button onclick="window.print()" class="btn btn-download">📥 Download PDF / Print</button>
    </div>

    <div class="invoice-box">
        <div class="top-bar">
            <div class="company-details">
                <h2>HOTEL RESERVATION</h2>
                <p>Official Booking Receipt & Invoice</p>
            </div>
            <div class="invoice-title">
                <h1>INVOICE</h1>
                <p style="margin: 5px 0 0 0; color: #777;">#@Model.OrderId.ToString("D6")</p>
            </div>
        </div>

        <div class="invoice-details">
            <div class="details-block">
                <strong>Billed To:</strong>
                <p>Customer: @Model.MemberEmail</p>
                <p>Payment Status: <strong>@Model.Status</strong></p>
            </div>
            <div class="details-block" style="text-align: right;">
                <strong>Invoice Date:</strong>
                <p>@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Accommodation</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Nights</th>
                    <th style="text-align: right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var nights = (item.CheckOutDate - item.CheckInDate).Days;
                    if (nights <= 0) nights = 1;

                    <tr>
                        <td><strong>@(item.Product?.Name ?? $"Room ID: {item.ProductId}")</strong></td>
                        <td>@item.CheckInDate.ToString("dd MMM yyyy")</td>
                        <td>@item.CheckOutDate.ToString("dd MMM yyyy")</td>
                        <td>@nights night(s)</td>
                        <td style="text-align: right;">RM @item.Price.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-section">
            <table class="total-table">
                <tr>
                    <td>Subtotal:</td>
                    <td style="text-align: right;">RM @Model.TotalAmount.ToString("0.00")</td>
                </tr>
                <tr>
                    <td>Tax / Charges (0%):</td>
                    <td style="text-align: right;">RM 0.00</td>
                </tr>
                <tr class="grand-total">
                    <td>Total Paid:</td>
                    <td style="text-align: right;">RM @Model.TotalAmount.ToString("0.00")</td>
                </tr>
            </table>
        </div>

        <div style="margin-top: 50px; text-align: center; color: #888; font-size: 13px; border-top: 1px solid #eee; padding-top: 20px;">
            Thank you for choosing our service!
        </div>
    </div>

</body>
</html>