@model RegisterVM

@{
    ViewBag.Title = "Admin Maintenance | Add Admin";
}

<div class="auth-card">
    <h1>New Admin</h1>

    <form asp-action="Add" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"></div>

        <label class="avatar-upload">
            <input asp-for="Photo" accept="image/jpeg,image/png" hidden onchange="previewPhoto(this)">
            <img id="photoPreview" src="/images/photo.jpg" alt="Preview">
            <small>Select Photo...</small>
        </label>
        <span asp-validation-for="Photo"></span>

        <input asp-for="Email" type="email" placeholder="Email" autofocus autocomplete="off">
        <span asp-validation-for="Email"></span>

        <input asp-for="Password" type="password" placeholder="Password">
        <span asp-validation-for="Password"></span>

        <input asp-for="Confirm" type="password" placeholder="Confirm Password">
        <span asp-validation-for="Confirm"></span>

        <input asp-for="Name" type="text" placeholder="Name">
        <span asp-validation-for="Name"></span>

        <div class="btn-group">
            <button type="submit">Add Admin</button>
            <a asp-action="Index" style="display: block; width: 100%; padding: 14px; text-align: center; text-decoration: none; color: #495057; background-color: #f1f3f5; border-radius: 25px; font-weight: 600; font-size: 16px; box-sizing: border-box;">Back</a>
        </div>
    </form>
</div>

@section foot {
    <script>
        $.validator.setDefaults({ ignore: '' });
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                document.getElementById('photoPreview').src = URL.createObjectURL(input.files[0]);
            }
        }
    </script>
}