@model ResetPasswordVM
@{
    ViewBag.Title = "Account | Reset Password";
    var sentEmail = ViewBag.Email as string;
}

<div class="auth-card" style="text-align: center;">
    @if (sentEmail != null)
    {
        <h1>Check Your Email</h1>
        <p style="font-size:14px; color:#555;">
            Temporary Password already send to your email<br />
            <strong>@sentEmail</strong>
        </p>
        <p style="font-size:12px; color:#999; margin: 12px 0 20px;">Please login with this password, then set a new password.</p>

        <a href="/Account/Login?email=@Uri.EscapeDataString(sentEmail)" class="btn-primary">Use Temporary Password To Login</a>

        <form method="post" asp-action="ResendTempPassword">
            <input type="hidden" name="email" value="@sentEmail" />
            <button type="submit" class="auth-links" style="border:none;background:none;width:100%;cursor:pointer;color:#4a6fd1;font-size:14px;text-decoration:underline;">Resend Temporary Password</button>
        </form>
    }
    else
    {
        <h1>Reset Password</h1>
        <form method="post" style="text-align: left;">
            <div asp-validation-summary="ModelOnly"></div>
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" placeholder="Email" autofocus autocomplete="off">
            <span asp-validation-for="Email"></span>
            <button type="submit">Get Temporary Password</button>
        </form>
        <div class="auth-links">
            <a href="/Account/Login">Back to Login</a>
        </div>
    }
</div>