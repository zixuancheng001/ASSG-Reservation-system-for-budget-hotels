@model DeactivateAccountVM
@{
    ViewBag.Title = "Account | Deactivate Account";
}

<div class="auth-card" style="text-align: center;">
    <h1>Deactivate Account</h1>
    <p style="font-size:14px; color:#555; margin-bottom: 4px;">
        This will permanently delete your account and all associated data.
    </p>
    <p style="font-size:12px; color:#999; margin: 0 0 20px;">
        This action cannot be undone. Please enter your password to confirm.
    </p>

    <form method="post" style="text-align: left;">
        <div asp-validation-summary="ModelOnly"></div>

        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" placeholder="Enter your password" autofocus autocomplete="off">
        <span asp-validation-for="Password"></span>

        <button type="submit" style="background: linear-gradient(90deg, #e05c5c 0%, #e6a8a8 100%);">
            Deactivate My Account
        </button>
    </form>

    <div class="auth-links">
        <a href="/Account/UpdateProfile">Cancel, Back to Profile</a>
    </div>
</div>
