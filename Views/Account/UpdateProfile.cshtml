@model UpdateProfileVM
@{
    ViewBag.Title = "Account | My Profile";
}

<div class="auth-card">
    <h1>My Profile</h1>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"></div>

        <label class="avatar-upload">
            <img id="photoPreview" src="@(Model.PhotoURL == null ? "/images/photo.jpg" : "/photos/" + Model.PhotoURL)" alt="Profile Photo">
            <small>Change Photo...</small>
            <input asp-for="Photo" accept="image/jpeg,image/png" hidden onchange="previewPhoto(this)">
        </label>
        <span asp-validation-for="Photo"></span>

        <label asp-for="Name">Name</label>
        <input asp-for="Name" type="text" autofocus>
        <span asp-validation-for="Name"></span>

        <label>Email</label>
        <input value="@Model.Email" disabled>

        <label>Role</label>
        <input value="@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Member") ? "Member" : "")" disabled>

        <button type="submit">Save Profile</button>
    </form>

    <div class="auth-links">
        <a href="/Account/UpdatePassword">Change Password</a>
        <a href="@(User.IsInRole("Admin") ? "/Home/Admin" : "/Home/Member")">Back to Home</a>
    </div>

    <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee; text-align: center;">
        <a href="/Account/DeactivateAccount" style="color:#e05c5c; font-size:13px; font-weight:600; text-decoration:none;">
            Deactivate Account
        </a>
    </div>
</div>

@section foot {
    <script>
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                document.getElementById('photoPreview').src = URL.createObjectURL(input.files[0]);
            }
        }
    </script>
}