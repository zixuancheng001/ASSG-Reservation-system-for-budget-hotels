@model ProductVM

@{
    ViewBag.Title = "Create Product";
}

<div class="card-container">
    <h1 class="card-title">Create Room</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="validation-summary-errors" asp-validation-summary="ModelOnly"></div>

        <!-- Room Name -->
        <div class="form-group">
            <label asp-for="Name">Room Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. King Ocean View" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>

        <!-- Category Dropdown -->
        <div class="form-group">
            <label asp-for="CategoryId">Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="field-validation-error"></span>
        </div>

        <!-- Price & Capacity Row -->
        <div class="form-row-2col form-group">
            <div>
                <label asp-for="Price">Price (RM)</label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="e.g. 250.00" />
                <span asp-validation-for="Price" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="Capacity">Capacity (Guests)</label>
                <input asp-for="Capacity" type="number" min="1" class="form-control" placeholder="e.g. 2" />
                <span asp-validation-for="Capacity" class="field-validation-error"></span>
            </div>
        </div>

        <!-- Status Toggles -->
        <div class="toggle-card">
            <input asp-for="IsAvailable" id="isAvailableCheck" />
            <label for="isAvailableCheck">Available for booking</label>
        </div>

        <div class="toggle-card maintenance">
            <input asp-for="IsMaintenance" type="checkbox" id="maintenanceSwitch" />
            <label for="maintenanceSwitch">🛠️ Under Maintenance (Temporarily hide from guest bookings)</label>
        </div>

        <!-- Room Amenities Pills -->
        <div class="form-group">
            <label class="form-label-bold">Room Amenities</label>
            <div class="amenities-grid">
                @{
                    var availableAmenities = new[] { "Free Wi-Fi", "Aircon", "Balcony", "Breakfast Included", "TV", "Mini Fridge" };
                }
                @foreach (var amenity in availableAmenities)
                {
                    <div class="amenity-pill">
                        <input type="checkbox"
                               name="SelectedAmenities"
                               value="@amenity"
                               id="amenity_@amenity.Replace(" ", "")"
                               @(Model?.SelectedAmenities != null && Model.SelectedAmenities.Contains(amenity) ? "checked" : "") />
                        <label for="amenity_@amenity.Replace(" ", "")">
                            @amenity
                        </label>
                    </div>
                }
            </div>
        </div>

        <!-- Room Photo Upload -->
        <div class="form-group">
            <label class="form-label-bold">Room Photo</label>
            <label class="photo-upload-box">
                <img id="photoPreview" src="@(Model?.PhotoURL == null ? "/images/photo.jpg" : "/photos/" + Model.PhotoURL)" alt="Room Photo Preview">
                <span class="photo-upload-text">Click to Upload / Change Photo...</span>
                <span class="photo-upload-subtext">JPEG, PNG or WEBP up to 5MB</span>
                <input asp-for="Photo" accept="image/jpeg,image/png" hidden onchange="previewPhoto(this)">
            </label>
            <span asp-validation-for="Photo" class="field-validation-error"></span>
        </div>

        <!-- Submit & Cancel Buttons -->
        <div class="form-actions">
            <button type="submit" class="btn-primary-custom">Save Room</button>
            <a asp-action="Index" class="btn-secondary-custom">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                document.getElementById('photoPreview').src = URL.createObjectURL(input.files[0]);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const availableCheck = document.getElementById("isAvailableCheck");
            const maintenanceSwitch = document.getElementById("maintenanceSwitch");

            // Untick 'Available' when 'Maintenance' is checked
            maintenanceSwitch.addEventListener("change", function () {
                if (this.checked) {
                    availableCheck.checked = false;
                }
            });

            // Untick 'Maintenance' when 'Available' is checked
            availableCheck.addEventListener("change", function () {
                if (this.checked) {
                    maintenanceSwitch.checked = false;
                }
            });
        });
    </script>
}