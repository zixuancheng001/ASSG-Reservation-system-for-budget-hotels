@{
    ViewBag.Title = "Member Maintenance";
}

<style>
    main {
        align-items: flex-start !important;
        padding: 32px 4% !important;
    }

    .data-card {
        width: 100% !important;
        max-width: 850px !important;
    }
</style>

<div class="data-card">
    <div class="card-header-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h1>Member Maintenance</h1>
    </div>

    <!-- CONTROL BAR -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
        <input type="text" id="searchInput" placeholder="Search name or email..."
               style="flex: 2; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;"
               oninput="queueMemberLoad()" />

        <select id="sortPicker" style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" onchange="loadMembers(1)">
            <option value="name_asc">Name (A-Z)</option>
            <option value="name_desc">Name (Z-A)</option>
            <option value="email_asc">Email (A-Z)</option>
            <option value="email_desc">Email (Z-A)</option>
        </select>
    </div>

    <div id="ajaxStatus" style="font-size: 13px; color: #777; margin: -8px 0 12px;"></div>

    <!-- TABLE -->
    <div style="width: 100%; overflow-x: auto;">
        <table class="custom-table" style="width: 100%; table-layout: fixed; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="width: 60px;">Photo</th>
                    <th style="width: 220px;">Email</th>
                    <th style="width: 120px;">Name</th>
                    <th style="width: 90px;">Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="memberTableBody">
                <!-- Rendered by JavaScript -->
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div id="paginationContainer" style="text-align: center; margin-top: 15px;"></div>
</div>

<!-- Hidden Anti-Forgery Token for JavaScript rendering -->
@Html.AntiForgeryToken()

@section scripts {
    <script>
        let searchTimer = null;
        let currentRequest = null;

        document.addEventListener("DOMContentLoaded", function () {
            loadMembers(1);
        });

        function queueMemberLoad() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => loadMembers(1), 250);
        }

        function loadMembers(page = 1) {
            const query = document.getElementById('searchInput').value;
            const sortBy = document.getElementById('sortPicker').value;

            const url = `/Member/GetMembersJson?query=${encodeURIComponent(query)}&sortBy=${encodeURIComponent(sortBy)}&page=${page}`;
            const tbody = document.getElementById('memberTableBody');
            const statusEl = document.getElementById('ajaxStatus');

            if (currentRequest) currentRequest.abort();
            currentRequest = new AbortController();

            statusEl.textContent = 'Loading members...';
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Loading member data...</td></tr>';

            fetch(url, { signal: currentRequest.signal })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const items = data.items || [];
                    const currentPage = data.currentPage || page;
                    const totalPages = data.totalPages || 1;
                    const totalItems = data.totalItems || items.length;

                    renderTable(items);
                    renderPagination(currentPage, totalPages);
                    statusEl.textContent = `${totalItems} member${totalItems === 1 ? '' : 's'} found`;
                })
                .catch(error => {
                    if (error.name === 'AbortError') return;
                    console.error('Error fetching members:', error);
                    statusEl.textContent = 'Unable to load members';
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:red;">Failed to load member data.</td></tr>';
                });
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function renderTable(members) {
            const tbody = document.getElementById('memberTableBody');
            tbody.innerHTML = '';

            // Retrieve anti-forgery token for delete and block forms
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const tokenHtml = tokenInput ? tokenInput.outerHTML : '';

            if (!members || members.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">No members found.</td></tr>';
                return;
            }

            members.forEach(m => {
                const email = escapeHtml(m.email || '');
                const name = escapeHtml(m.name || '');
                const photoURL = encodeURIComponent(m.photoURL || 'photo.jpg');
                const isBlocked = m.isBlocked;

                // Status badge
                let statusBadge = '';
                if (isBlocked) {
                    statusBadge = '<span class="badge-no">Blocked</span>';
                } else {
                    statusBadge = '<span class="badge-yes">Active</span>';
                }

                // Block / Unblock button
                let blockBtn = '';
                if (isBlocked) {
                    blockBtn = `<button type="button" class="btn-edit" onclick="toggleBlock('${email}')">Unblock</button>`;
                } else {
                    blockBtn = `<button type="button" class="btn-delete" style="background:#e67e22;" onclick="toggleBlock('${email}')">Block</button>`;
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><img src="/photos/${photoURL}" class="table-img" style="width:40px; height:40px; object-fit:cover; border-radius:50%;" onerror="this.src='/images/photo.jpg';" /></td>
                    <td><strong>${email}</strong></td>
                    <td>${name}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/Member/Edit/${email}" class="btn-edit">Edit</a>
                            ${blockBtn}
                            <form action="/Member/Delete/${email}" method="post" onsubmit="return confirm('Are you sure you want to delete this member?');" style="display:inline;">
                                ${tokenHtml}
                                <button type="submit" class="btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function toggleBlock(email) {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            fetch('/Member/ToggleBlock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${encodeURIComponent(email)}&__RequestVerificationToken=${encodeURIComponent(token)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadMembers(1);
                } else {
                    alert(data.message || 'Unable to update member status.');
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function renderPagination(currentPage, totalPages) {
            const container = document.getElementById('paginationContainer');
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            container.innerHTML = `
                <div style="display: inline-flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: center;">
                    <button type="button" class="btn-action-gradient" ${currentPage === 1 ? 'disabled' : ''} onclick="loadMembers(${currentPage - 1})">Previous</button>
                    ${renderPageButtons(currentPage, totalPages)}
                    <button type="button" class="btn-action-gradient" ${currentPage === totalPages ? 'disabled' : ''} onclick="loadMembers(${currentPage + 1})">Next</button>
                </div>
            `;
        }

        function renderPageButtons(currentPage, totalPages) {
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                const active = i === currentPage;
                html += `<button type="button" onclick="loadMembers(${i})" style="min-width:36px; padding:8px 10px; border-radius:999px; border:1px solid ${active ? '#8ea6e0' : '#ddd'}; background:${active ? '#f0edfa' : '#fff'}; color:${active ? '#6b52ae' : '#555'}; font-weight:700; cursor:pointer;">${i}</button>`;
            }
            return html;
        }
    </script>
}
