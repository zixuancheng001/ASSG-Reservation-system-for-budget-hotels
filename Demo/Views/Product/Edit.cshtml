@model ProductVM

@{
    ViewBag.Title = "Edit Room";
}

<div class="data-card" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header-bar" style="margin-bottom: 20px;">
        <h1>Edit Room</h1>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div class="validation-summary-errors" asp-validation-summary="ModelOnly"></div>

        <!-- Hidden inputs ensure ProductId and PhotoURL reach POST controller -->
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="PhotoURL" />

        <div style="margin-bottom: 15px;">
            <label style="font-weight: bold; display: block; margin-bottom: 5px;">Room ID</label>
            <input value="@Model.ProductId" readonly style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc; background-color: #e9ecef;" />
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Name" style="font-weight: bold; display: block; margin-bottom: 5px;">Room Name</label>
            <input asp-for="Name" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" />
            <span asp-validation-for="Name" class="field-validation-error" style="color: red; font-size: 0.875rem;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="CategoryId" style="font-weight: bold; display: block; margin-bottom: 5px;">Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;"></select>
            <span asp-validation-for="CategoryId" class="field-validation-error" style="color: red; font-size: 0.875rem;"></span>
        </div>

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div style="flex: 1;">
                <label asp-for="Price" style="font-weight: bold; display: block; margin-bottom: 5px;">Price (RM)</label>
                <input asp-for="Price" type="number" step="0.01" min="0" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" />
                <span asp-validation-for="Price" class="field-validation-error" style="color: red; font-size: 0.875rem;"></span>
            </div>

            <div style="flex: 1;">
                <label asp-for="Capacity" style="font-weight: bold; display: block; margin-bottom: 5px;">Capacity (Guests)</label>
                <input asp-for="Capacity" type="number" min="1" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" />
                <span asp-validation-for="Capacity" class="field-validation-error" style="color: red; font-size: 0.875rem;"></span>
            </div>
        </div>

        <div style="margin-bottom: 15px; display: flex; align-items: center; gap: 8px;">
            <input asp-for="IsAvailable" id="isAvailableCheck" style="width: 18px; height: 18px; cursor: pointer;" />
            <label for="isAvailableCheck" style="margin: 0; cursor: pointer; font-weight: bold;">Available for booking</label>
        </div>

        <div style="margin-bottom: 20px; padding: 12px; border: 1px solid #ffc107; border-radius: 8px; background-color: #fff3cd; display: flex; align-items: center; gap: 8px;">
            <input asp-for="IsMaintenance" type="checkbox" id="maintenanceSwitch" style="width: 18px; height: 18px; cursor: pointer;" />
            <label for="maintenanceSwitch" style="margin: 0; cursor: pointer; font-weight: bold; color: #856404;">
                🛠️ Under Maintenance (Temporarily hide from guest bookings)
            </label>
        </div>

        <!-- AMENITIES SECTION -->
        <div class="form-group">
            <label class="form-label-bold">Room Amenities</label>
            <div class="amenities-grid">
                @{
                    var availableAmenities = new[] { "Free Wi-Fi", "Aircon", "Balcony", "Breakfast Included", "TV", "Mini Fridge" };
                }
                @foreach (var amenity in availableAmenities)
                {
                    <div class="amenity-pill">
                        <input type="checkbox"
                               name="SelectedAmenities"
                               value="@amenity"
                               id="amenity_@amenity.Replace(" ", "")"
                               @(Model?.SelectedAmenities != null && Model.SelectedAmenities.Contains(amenity) ? "checked" : "") />
                        <label for="amenity_@amenity.Replace(" ", "")">
                            @amenity
                        </label>
                    </div>
                }
            </div>
        </div>

        <!-- PHOTO SECTION WITH FUNCTIONAL BUTTON -->
        <div style="margin-bottom: 20px;">
            <label style="font-weight: bold; display: block; margin-bottom: 8px;">Current Photo</label>
            <div style="margin-bottom: 10px;">
                <img id="photoPreview"
                     src="~/photos/@(string.IsNullOrEmpty(Model?.PhotoURL) ? "photo.jpg" : Model.PhotoURL)"
                     style="width: 120px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid #ccc;"
                     onerror="this.src='/images/photo.jpg';" />
            </div>

            <!-- Functional Change Photo Button -->
            <label for="photoInput" class="btn-action-gradient" style="display: inline-block; padding: 8px 16px; cursor: pointer; text-align: center; border-radius: 8px; margin-bottom: 5px;">
                📷 Choose / Change Photo
            </label>

            <input asp-for="Photo" id="photoInput" type="file" accept="image/*" onchange="previewPhoto(this)" style="display: none;" />
            <span id="fileNameDisplay" style="display: block; font-size: 0.85rem; color: #555; margin-top: 4px;"></span>
            <span asp-validation-for="Photo" class="field-validation-error" style="color: red; font-size: 0.875rem;"></span>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; margin-top: 20px;">
            <button type="submit" class="btn-action-gradient" style="padding: 10px 20px; border: none; cursor: pointer;">Update Room</button>
            <a asp-action="Index" style="text-decoration: none; color: #6c757d; font-weight: bold;">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                document.getElementById('photoPreview').src = URL.createObjectURL(file);
                document.getElementById('fileNameDisplay').textContent = "Selected: " + file.name;
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const availableCheck = document.getElementById("isAvailableCheck");
            const maintenanceSwitch = document.getElementById("maintenanceSwitch");

            // Untick 'Available' when 'Maintenance' is checked
            maintenanceSwitch.addEventListener("change", function () {
                if (this.checked) {
                    availableCheck.checked = false;
                }
            });

            // Untick 'Maintenance' when 'Available' is checked
            availableCheck.addEventListener("change", function () {
                if (this.checked) {
                    maintenanceSwitch.checked = false;
                }
            });
        });
    </script>
}