@model IEnumerable<Demo.Models.Product>

@{
    ViewBag.Title = "Product Maintenance";
}

<style>
    /* Override global centering for this page */
    main {
        align-items: flex-start !important;
        padding: 32px 4% !important;
    }

    .data-card {
        width: 100% !important;
        max-width: 1400px !important;
    }
</style>

<div class="data-card">
    <div class="card-header-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h1>Product / Room Maintenance</h1>
        <a asp-action="Create" class="btn-action-gradient">+ Add New Room</a>
    </div>

    <!-- CONTROL BAR -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
        <input type="text" id="searchInput" placeholder="Search room name or ID..."
               style="flex: 2; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;"
               oninput="queueProductLoad()" />

        <select id="categoryFilter" style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" onchange="loadProducts(1)">
            <option value="">All Categories</option>
            @if (ViewBag.CategoryList != null)
            {
                foreach (var cat in (SelectList)ViewBag.CategoryList)
                {
                    <option value="@cat.Value">@cat.Text</option>
                }
            }
        </select>

        <select id="statusFilter" style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" onchange="loadProducts(1)">
            <option value="">All Status</option>
            <option value="available">Available</option>
            <option value="booked">Booked</option>
            <option value="maintenance">Maintenance</option>
        </select>

        <select id="sortPicker" style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" onchange="loadProducts(1)">
            <option value="name_asc">Name (A-Z)</option>
            <option value="name_desc">Name (Z-A)</option>
            <option value="id_asc">ID (A-Z / Low to High)</option>
            <option value="id_desc">ID (Z-A / High to Low)</option>
            <option value="price_asc">Price (Low to High)</option>
            <option value="price_desc">Price (High to Low)</option>
        </select>
    </div>

    <div id="ajaxStatus" style="font-size: 13px; color: #777; margin: -8px 0 12px;"></div>

    <!-- TABLE -->
    <div style="width: 100%; overflow-x: auto;">
        <table class="custom-table" style="width: 100%; table-layout: auto; border-collapse: collapse;">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>ID</th>
                    <th>Room Name</th>
                    <th>Category</th>
                    <th>Price/Night</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th>Maintenance</th>
                    <th>Amenities</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                <!-- Rendered by JavaScript dynamically -->
            </tbody>
        </table>
    </div>

    <!-- PAGINATION CONTROLS -->
    <div id="paginationContainer" style="text-align: center; margin-top: 15px;"></div>
</div>

<!-- Hidden Anti-Forgery Token for JavaScript rendering -->
@Html.AntiForgeryToken()

@section scripts {
    <script>
        let searchTimer = null;
        let currentRequest = null;

        document.addEventListener("DOMContentLoaded", function () {
            loadProducts(1);
        });

        function queueProductLoad() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => loadProducts(1), 250);
        }

        function loadProducts(page = 1) {
            const query = document.getElementById('searchInput').value;
            const categoryId = document.getElementById('categoryFilter').value;
            const status = document.getElementById('statusFilter').value;
            const sortBy = document.getElementById('sortPicker').value;

            const url = `/Product/GetProductsJson?query=${encodeURIComponent(query)}&categoryId=${encodeURIComponent(categoryId)}&status=${encodeURIComponent(status)}&sortBy=${encodeURIComponent(sortBy)}&page=${page}`;
            const tbody = document.getElementById('productTableBody');
            const statusEl = document.getElementById('ajaxStatus');

            if (currentRequest) currentRequest.abort();
            currentRequest = new AbortController();

            statusEl.textContent = 'Loading rooms...';
            tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;">Loading room data...</td></tr>';

            fetch(url, { signal: currentRequest.signal })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const items = data.items || data.Items || (Array.isArray(data) ? data : []);
                    const currentPage = data.currentPage || data.CurrentPage || page;
                    const totalPages = data.totalPages || data.TotalPages || 1;
                    const totalItems = data.totalItems || data.TotalItems || items.length;

                    renderTable(items);
                    renderPagination(currentPage, totalPages);
                    statusEl.textContent = `${totalItems} room${totalItems === 1 ? '' : 's'} found`;
                })
                .catch(error => {
                    if (error.name === 'AbortError') return;
                    console.error('Error fetching room products:', error);
                    statusEl.textContent = 'Unable to load rooms';
                    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:red;">Failed to load room data. Please check the controller response.</td></tr>';
                });
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function renderTable(products) {
            const tbody = document.getElementById('productTableBody');
            tbody.innerHTML = '';

            // Retrieve anti-forgery token string generated by @Html.AntiForgeryToken()
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const tokenHtml = tokenInput ? tokenInput.outerHTML : '';

            if (!products || products.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;">No rooms found.</td></tr>';
                return;
            }

            products.forEach(p => {
                const id = escapeHtml(p.productId || p.ProductId || '');
                const name = escapeHtml(p.name || p.Name || '');
                const category = escapeHtml(p.categoryName || p.CategoryName || p.category?.name || p.Category?.Name || p.categoryId || p.CategoryId || '-');
                const price = p.price !== undefined ? p.price : (p.Price !== undefined ? p.Price : 0);
                const capacity = p.capacity !== undefined ? p.capacity : (p.Capacity !== undefined ? p.Capacity : 0);
                const isAvailable = p.isAvailable !== undefined ? p.isAvailable : p.IsAvailable;
                const isMaintenance = p.isMaintenance !== undefined ? p.isMaintenance : p.IsMaintenance;
                const rawAmenities = p.amenities || p.Amenities || '';
                const photoURL = encodeURIComponent(p.photoURL || p.PhotoURL || p.photoUrl || 'photo.jpg');

                // Format amenities tags
                let amenitiesHtml = '-';
                if (rawAmenities && rawAmenities.trim() !== '') {
                    const amenitiesList = rawAmenities.split(',');
                    amenitiesHtml = amenitiesList.map(item =>
                        `<span style="display:inline-block; background-color:#e9ecef; color:#495057; border-radius:4px; padding:2px 6px; font-size:12px; margin:2px;">${escapeHtml(item.trim())}</span>`
                    ).join('');
                }

                // Maintenance badge
                const maintenanceBadge = isMaintenance
                    ? '<span class="badge-no" style="background-color:#fff3cd; color:#856404; border:1px solid #ffeeba;">🛠️ Under Maintenance</span>'
                    : '<span style="color:#28a745; font-weight:bold;">Normal</span>';

                // Status logic: If under maintenance, booking is disabled
                let statusBadge = '';
                if (isMaintenance) {
                    statusBadge = '<span class="badge-no" style="opacity: 0.6; cursor: not-allowed;" title="Room is under maintenance">Unavailable</span>';
                } else if (isAvailable) {
                    statusBadge = '<span class="badge-yes">Available</span>';
                } else {
                    statusBadge = '<span class="badge-no">Booked</span>';
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><img src="/photos/${photoURL}" class="table-img" style="width:50px; height:50px; object-fit:cover; border-radius:8px;" onerror="this.src='/images/photo.jpg';" /></td>
                    <td><strong>${id}</strong></td>
                    <td>${name}</td>
                    <td>${category}</td>
                    <td>RM ${Number(price).toFixed(2)}</td>
                    <td>${capacity} Guests</td>
                    <td>
                        <button type="button" style="border:none; background:none; cursor:${isMaintenance ? 'not-allowed' : 'pointer'};"
                                ${isMaintenance ? 'disabled' : ''}
                                onclick="toggleStatus('${id}', this)">
                            ${statusBadge}
                        </button>
                    </td>
                    <td>${maintenanceBadge}</td>
                    <td style="max-width: 180px;">${amenitiesHtml}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/Product/Edit/${id}" class="btn-edit">Edit</a>
                            <form action="/Product/Delete/${id}" method="post" onsubmit="return confirm('Are you sure you want to delete this room?');" style="display:inline;">
                                ${tokenHtml}
                                <button type="submit" class="btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderPagination(currentPage, totalPages) {
            const container = document.getElementById('paginationContainer');
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            container.innerHTML = `
                <div style="display: inline-flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: center;">
                    <button type="button" class="btn-action-gradient" ${currentPage === 1 ? 'disabled' : ''} onclick="loadProducts(${currentPage - 1})">Previous</button>
                    ${renderPageButtons(currentPage, totalPages)}
                    <button type="button" class="btn-action-gradient" ${currentPage === totalPages ? 'disabled' : ''} onclick="loadProducts(${currentPage + 1})">Next</button>
                </div>
            `;
        }

        function renderPageButtons(currentPage, totalPages) {
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                const active = i === currentPage;
                html += `<button type="button" onclick="loadProducts(${i})" style="min-width:36px; padding:8px 10px; border-radius:999px; border:1px solid ${active ? '#8ea6e0' : '#ddd'}; background:${active ? '#f0edfa' : '#fff'}; color:${active ? '#6b52ae' : '#555'}; font-weight:700; cursor:pointer;">${i}</button>`;
            }
            return html;
        }

        function toggleStatus(productId, btnElement) {
            fetch('/Product/ToggleAvailability', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${encodeURIComponent(productId)}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const isAvailable = data.isAvailable !== undefined ? data.isAvailable : data.IsAvailable;
                    btnElement.innerHTML = isAvailable
                        ? '<span class="badge-yes">Available</span>'
                        : '<span class="badge-no">Booked</span>';
                } else {
                    alert(data.message || 'Unable to toggle status.');
                }
            })
            .catch(err => console.error('Error toggling status:', err));
        }
    </script>
}