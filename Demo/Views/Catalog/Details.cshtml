@model Product

@{
    ViewData["Title"] = "Room Details";
}

<style>
    .details-page {
        min-height: calc(100vh - 70px);
        background: #f7f7fb;
        padding: 45px 6%;
    }

    .details-container {
        max-width: 1050px;
        margin: 0 auto;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 22px;
        color: #655bd0;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .back-link:hover {
            color: #4e45b6;
        }

    .details-card {
        background: white;
        border-radius: 22px;
        padding: 28px;
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 40px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

    /* Image */

    .room-photo {
        width: 100%;
        height: 420px;
        object-fit: cover;
        border-radius: 16px;
    }

    .photo-placeholder {
        width: 100%;
        height: 420px;
        border-radius: 16px;
        background: #eeeef5;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #999;
    }

    /* Information */

    .room-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .room-label {
        display: inline-block;
        width: fit-content;
        background: #f0effd;
        color: #655bd0;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .room-title {
        margin: 0;
        font-size: 34px;
        color: #202033;
    }

    .room-id {
        margin-top: 7px;
        color: #888;
        font-size: 14px;
    }

    .availability {
        display: inline-block;
        width: fit-content;
        margin-top: 15px;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .available {
        background: #e8f8ef;
        color: #179957;
    }

    .unavailable {
        background: #fdebec;
        color: #d94350;
    }

    .room-description {
        margin-top: 25px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .info-box {
        background: #f8f8fc;
        padding: 15px;
        border-radius: 12px;
    }

        .info-box span {
            display: block;
            color: #888;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .info-box strong {
            color: #333;
            font-size: 15px;
        }

    .room-price {
        margin-top: 24px;
        font-size: 28px;
        font-weight: 700;
        color: #655bd0;
    }

        .room-price span {
            color: #888;
            font-size: 13px;
            font-weight: 400;
        }

    /* Booking */

    .booking-box {
        margin-top: 25px;
        padding-top: 22px;
        border-top: 1px solid #eee;
    }

        .booking-box h3 {
            margin: 0 0 16px;
            color: #333;
            font-size: 18px;
        }

    .date-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .date-field label {
        display: block;
        color: #666;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .date-field input {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 12px;
        border: 1px solid #ddd;
        border-radius: 9px;
        font-size: 14px;
        outline: none;
    }

        .date-field input:focus {
            border-color: #756bd8;
        }

    .add-cart-button {
        width: 100%;
        margin-top: 16px;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #7067d8, #a86fd3);
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }

    .secondary-button { width: 100%; margin-top: 10px; padding: 11px; border: 1px solid #7067d8; border-radius: 10px; background: white; color: #655bd0; font-weight: 600; cursor: pointer; }
    .reviews-section { margin-top: 28px; background: white; border-radius: 20px; padding: 28px; box-shadow: 0 8px 30px rgba(0,0,0,.06); }
    .review-card { padding: 16px 0; border-bottom: 1px solid #eee; }
    .review-card:last-child { border-bottom: 0; }
    .stars { color: #f59e0b; letter-spacing: 1px; }

        .add-cart-button:hover {
            opacity: 0.9;
        }

    .unavailable-message {
        margin-top: 20px;
        padding: 14px;
        border-radius: 10px;
        background: #fff1f2;
        color: #d94350;
        font-size: 14px;
    }

    .message {
        padding: 13px 17px;
        border-radius: 10px;
        margin-bottom: 20px;
        background: white;
    }

    .error-message {
        color: #d94350;
        border-left: 4px solid #d94350;
    }

    .success-message {
        color: #179957;
        border-left: 4px solid #179957;
    }

    @@media (max-width: 800px) {
        .details-card {
            grid-template-columns: 1fr;
        }

        .room-photo,
        .photo-placeholder {
            height: 300px;
        }
    }

    @@media (max-width: 550px) {
        .room-description,
        .date-row {
            grid-template-columns: 1fr;
        }

        .room-title {
            font-size: 28px;
        }
    }
</style>


<div class="details-page">

    <div class="details-container">

        <!-- Back -->

        <a asp-action="Index"
           class="back-link">
            ← Back to Room Catalog
        </a>


        <!-- Messages handled by toast notification in _Layout -->


        <!-- Room -->

        <div class="details-card">

            <!-- LEFT: PHOTO -->

            <div>

                @if (!string.IsNullOrEmpty(Model.PhotoURL))
                {
                    <img src="/photos/@Model.PhotoURL"
                         class="room-photo"
                         alt="@Model.Name" />
                }
                else
                {
                    <div class="photo-placeholder">
                        No Photo Available
                    </div>
                }

            </div>


            <!-- RIGHT: INFORMATION -->

            <div class="room-info">

                <span class="room-label">
                    HOTEL ROOM
                </span>

                <h1 class="room-title">
                    @Model.Name
                </h1>

                <div class="room-id">
                    Room ID: @Model.ProductId
                </div>


                @if (Model.IsAvailable)
                {
                    <span class="availability available">
                        ● Available
                    </span>
                }
                else
                {
                    <span class="availability unavailable">
                        ● Currently Unavailable
                    </span>
                }


                <!-- Room Info -->

                <div class="room-description">

                    <div class="info-box">
                        <span>Category</span>

                        <strong>
                            @Model.Category?.Name
                        </strong>
                    </div>

                    <div class="info-box">
                        <span>Capacity</span>

                        <strong>
                            @Model.Capacity Guests
                        </strong>
                    </div>

                </div>


                <!-- Price -->

                <div class="room-price">
                    RM @Model.Price.ToString("0.00")
                    <span>/ night</span>
                </div>

                <div style="margin-top:10px; color:#666;">⭐ @(((double)ViewBag.AverageRating).ToString("0.0")) / 5 (@(((IEnumerable<Demo.Models.RoomReview>)ViewBag.Reviews).Count()) review(s))</div>

                <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="secondary-button">@((bool)ViewBag.IsWishlisted ? "♥ Remove from Wishlist" : "♡ Save to Wishlist")</button>
                </form>


                <!-- Booking -->
                @if (Model.IsAvailable)
                {
                    <div class="booking-box">

                        <h3>
                            Select Your Stay
                        </h3>

                        <form asp-controller="Cart"
                              asp-action="Add"
                              method="post">

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.ProductId" />

                            <div class="date-row">

                                <div class="date-field">

                                    <label>
                                        Check-in
                                    </label>

                                    <input type="date"
                                           id="checkInDate"
                                           name="checkInDate"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           required />

                                </div>


                                <div class="date-field">

                                    <label>
                                        Check-out
                                    </label>

                                    <input type="date"
                                           id="checkOutDate"
                                           name="checkOutDate"
                                           min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                           required />

                                </div>

                            </div>


                            <button type="submit"
                                    class="add-cart-button">
                                🛒 Add to Cart
                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <div class="unavailable-message">
                        This room is currently unavailable.
                    </div>
                }

            </div>

        </div>

        <div class="reviews-section">
            <h2 style="margin-top:0; color:#202033;">Guest Reviews</h2>
            @if ((bool)ViewBag.CanReview)
            {
                var mine = ViewBag.MyReview as Demo.Models.RoomReview;
                <form asp-controller="Review" asp-action="Save" method="post" style="margin:18px 0; padding:18px; background:#f8f8fc; border-radius:12px;">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <label style="display:block; margin-bottom:8px; font-weight:600;">Your rating</label>
                    <select name="rating" required style="padding:9px; border-radius:8px; border:1px solid #ddd;">
                        @for (var rating = 5; rating >= 1; rating--)
                        {
                            @if (mine?.Rating == rating)
                            {
                                <option value="@rating" selected>@rating star@(rating == 1 ? "" : "s")</option>
                            }
                            else
                            {
                                <option value="@rating">@rating star@(rating == 1 ? "" : "s")</option>
                            }
                        }
                    </select>
                    <textarea name="comment" maxlength="500" required placeholder="Share your stay experience..." style="display:block; width:100%; box-sizing:border-box; min-height:90px; margin:12px 0; padding:10px; border:1px solid #ddd; border-radius:8px;">@mine?.Comment</textarea>
                    <button type="submit" class="add-cart-button" style="margin-top:0;">@(mine == null ? "Submit Review" : "Update Review")</button>
                </form>
            }
            else
            {
                <p style="color:#777;">Only members who have completed a stay can leave a review.</p>
            }

            @foreach (var review in (IEnumerable<Demo.Models.RoomReview>)ViewBag.Reviews)
            {
                <div class="review-card">
                    <strong>@(review.Member?.Name ?? "Guest")</strong>
                    <span class="stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                    <span style="float:right; color:#888; font-size:13px;">@review.CreatedAt.ToString("dd MMM yyyy")</span>
                    <p style="margin:8px 0 0; color:#555; white-space:pre-wrap;">@review.Comment</p>
                </div>
            }
        </div>

    </div>

</div>
@section Scripts {
    <script>
        const checkIn = document.getElementById("checkInDate");
        const checkOut = document.getElementById("checkOutDate");

        checkIn.addEventListener("change", function () {

            if (!checkIn.value) {
                return;
            }

            const date = new Date(checkIn.value);

            date.setDate(date.getDate() + 1);

            const minimumCheckout =
                date.toISOString().split("T")[0];

            checkOut.min = minimumCheckout;

            // Clear invalid checkout date
            if (checkOut.value && checkOut.value <= checkIn.value) {
                checkOut.value = "";
            }
        });
    </script>
}
