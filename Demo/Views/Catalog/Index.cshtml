@model List<Product>

@{
    ViewData["Title"] = "Room Catalog";
}

<style>
    .catalog-page {
        min-height: calc(100vh - 70px);
        background: #f7f7fb;
        padding: 45px 6%;
    }

    .catalog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .catalog-header h1 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            color: #202033;
        }

        .catalog-header p {
            margin-top: 8px;
            color: #777;
            font-size: 15px;
        }

    .header-actions {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .view-toggle-group {
        display: flex;
        background: #eeeef5;
        padding: 4px;
        border-radius: 12px;
        gap: 4px;
    }

    .btn-toggle {
        padding: 10px 18px;
        border-radius: 9px;
        border: none;
        background: transparent;
        color: #666;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
    }

        .btn-toggle.active {
            background: white;
            color: #655bd0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

    .cart-button {
        background: linear-gradient(135deg, #7067d8, #a86fd3);
        color: white;
        text-decoration: none;
        padding: 11px 22px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        height: 43px;
        box-sizing: border-box;
    }

        .cart-button:hover {
            color: white;
            transform: translateY(-2px);
        }

    .search-card {
        background: white;
        padding: 22px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        margin-bottom: 30px;
    }

    .search-form {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .search-input {
        flex: 1;
        padding: 13px 16px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        outline: none;
    }

        .search-input:focus {
            border-color: #756bd8;
        }

    .category-select {
        padding: 13px 16px;
        border: 1px solid #ddd;
        border-radius: 10px;
        min-width: 190px;
        font-size: 15px;
        background: white;
    }

    .search-button {
        padding: 13px 24px;
        border: none;
        border-radius: 10px;
        background: #756bd8;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

        .search-button:hover {
            background: #6258c7;
        }

    /* Standard Grid View */
    .room-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .room-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        transition: 0.25s;
        display: flex;
        flex-direction: column;
    }

        .room-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 36px rgba(112,103,216,0.14);
        }

    .room-image {
        width: 100%;
        height: 185px;
        object-fit: cover;
        display: block;
    }

    .room-image-placeholder {
        width: 100%;
        height: 185px;
        background: linear-gradient(135deg, #eeeef5, #e0dffa);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 14px;
        flex-direction: column;
        gap: 8px;
    }

    .room-content {
        padding: 18px 20px 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .room-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
    }

    .room-name {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #222;
        line-height: 1.3;
    }

    .room-id {
        color: #aaa;
        font-size: 12px;
        margin-top: 4px;
    }

    .status {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .available {
        background: #e8f8ef;
        color: #179957;
    }

    .unavailable {
        background: #fdebec;
        color: #d94350;
    }

    .room-info {
        margin-top: 14px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .info-item {
        font-size: 12px;
        color: #999;
        line-height: 1.3;
    }

        .info-item strong {
            display: block;
            color: #444;
            font-size: 13px;
            margin-top: 2px;
        }

    .price {
        margin-top: 14px;
        font-size: 20px;
        font-weight: 700;
        color: #655bd0;
    }

        .price span {
            font-size: 12px;
            color: #aaa;
            font-weight: 400;
        }

    .details-button {
        display: block;
        text-align: center;
        margin-top: auto;
        padding-top: 11px;
        padding-bottom: 11px;
        border-radius: 10px;
        background: #f0effd;
        color: #5e54c8;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
        margin-top: 16px;
    }

        .details-button:hover {
            background: #e4e2fb;
            color: #4e45b6;
        }

    .empty-card {
        background: white;
        border-radius: 18px;
        padding: 50px;
        text-align: center;
        color: #777;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        grid-column: 1 / -1;
    }

    /* --- REFINED ARCHITECTURAL FLOOR PLAN (高阶高级建筑蓝图) --- */
    #mapViewContainer {
        background: #16181D;
        padding: 35px;
        border-radius: 24px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.35);
        color: #fff;
        border: 1px solid #232732;
    }

    .blueprint-card {
        background: #1C1F26;
        border: 1px solid #2a2f3a;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 28px;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .blueprint-title {
        font-size: 18px;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        letter-spacing: 0.3px;
    }

    .svg-blueprint-wrapper {
        width: 100%;
        background: #181a1f;
        border: 2px solid #333845;
        border-radius: 16px;
        overflow-x: auto;
        box-shadow: inset 0 0 30px rgba(0,0,0,0.85);
    }

    .svg-room {
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .svg-room:hover rect {
            filter: brightness(1.2);
            stroke-width: 2.5px;
        }

    @@media (max-width: 1100px) {
        .room-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .catalog-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .header-actions {
            width: 100%;
            justify-content: space-between;
        }

        .search-form {
            flex-direction: column;
            align-items: stretch;
        }

        .category-select,
        .search-button {
            width: 100%;
        }

        .room-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="catalog-page">

    <div class="catalog-header">
        <div>
            <h1>Room Catalog</h1>
            <p>Find the perfect room for your stay</p>
        </div>

        <div class="header-actions">
            <div class="view-toggle-group">
                <button type="button" id="btnGrid" class="btn-toggle active" onclick="switchView('grid')">📋 Catalog</button>
                <button type="button" id="btnMap" class="btn-toggle" onclick="switchView('map')">🗺️ Floor Map</button>
            </div>

            <a asp-controller="Cart"
               asp-action="Index"
               class="cart-button">
                🛒 My Cart
            </a>
        </div>
    </div>

    <div class="search-card">
        <form method="get"
              asp-action="Index"
              class="search-form">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="search-input"
                   placeholder="Search rooms by name..." />

            <select name="categoryId"
                    class="category-select">
                <option value="">All Categories</option>

                @foreach (var category in ViewBag.Categories)
                {
                    if (ViewBag.CategoryId == category.CategoryId)
                    {
                        <option value="@category.CategoryId" selected>
                            @category.Name
                        </option>
                    }
                    else
                    {
                        <option value="@category.CategoryId">
                            @category.Name
                        </option>
                    }
                }
            </select>

            <button type="submit"
                    class="search-button">
                Search
            </button>
        </form>
    </div>

    <!-- 1. Grid Catalog View -->
    <div id="gridContainer">
        @if (Model.Count == 0)
        {
            <div class="empty-card">
                <h2>No rooms found</h2>
                <p>Try another room name or category.</p>
            </div>
        }
        else
        {
            <div class="room-grid">
                @foreach (var product in Model)
                {
                    <div class="room-card">
                        @if (!string.IsNullOrEmpty(product.PhotoURL))
                        {
                            <img src="/photos/@product.PhotoURL"
                                 class="room-image"
                                 alt="@product.Name" />
                        }
                        else
                        {
                            <div class="room-image-placeholder">
                                No Photo
                            </div>
                        }

                        <div class="room-content">
                            <div class="room-top">
                                <div>
                                    <h2 class="room-name">@product.Name</h2>
                                    <div class="room-id">@product.ProductId</div>
                                </div>

                                @if (product.IsAvailable)
                                {
                                    <span class="status available">● Available</span>
                                }
                                else
                                {
                                    <span class="status unavailable">● Unavailable</span>
                                }
                            </div>

                            <div class="room-info">
                                <div class="info-item">
                                    Category
                                    <strong>@product.Category?.Name</strong>
                                </div>

                                <div class="info-item">
                                    Capacity
                                    <strong>👤 @product.Capacity Guests</strong>
                                </div>
                            </div>

                            <div class="price">
                                RM @product.Price.ToString("0.00")
                                <span>/ night</span>
                            </div>

                            <a asp-action="Details"
                               asp-route-id="@product.ProductId"
                               class="details-button">
                                View Room Details →
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 2. TRUE ARCHITECTURAL FLOOR PLAN (严格按序排列、干净高级的建筑蓝图) -->
    <div id="mapViewContainer" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px;">
            <div>
                <h2 style="margin:0; font-size: 21px; color: #ffffff; font-weight: 700;">Architectural Floor Plan Layout</h2>
                <p style="color: #94a3b8; font-size: 13px; margin-top: 4px;">Precise structural zoning with sequential corridor alignment.</p>
            </div>
            <!-- 右上角图例 -->
            <div style="display: flex; gap: 18px; font-size: 12px; font-weight: 600; background: #1c1f26; padding: 8px 16px; border-radius: 10px; border: 1px solid #2a2f3a;">
                <span style="display:flex; align-items:center; gap:6px; color:#5EEA8A;"><span style="width:8px; height:8px; background:#5EEA8A; border-radius:50%; box-shadow: 0 0 8px rgba(94, 234, 138, 0.4);"></span> Available</span>
                <span style="display:flex; align-items:center; gap:6px; color:#FFA756;"><span style="width:8px; height:8px; background:#FFA756; border-radius:50%; box-shadow: 0 0 8px rgba(255, 167, 86, 0.4);"></span> Booked</span>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding: 40px; color: #94a3b8;">No rooms available to display on layout.</div>
        }
        else
        {
            // 按楼层分组，并且在组内严格按照 ProductId 升序排列 (Room101, Room102, Room103...)
            var floorGroups = Model.GroupBy(p =>
            {
                string idStr = p.ProductId?.Trim() ?? "";
                var match = System.Text.RegularExpressions.Regex.Match(idStr, @"\d+");
                if (match.Success && match.Value.Length > 0)
                {
                    return $"Level {match.Value[0]} Architectural Layout";
                }
                return "Main Level Architectural Layout";
            }).OrderBy(g => g.Key);

            foreach (var floor in floorGroups)
            {
                var sortedRooms = floor.OrderBy(r => r.ProductId).ToList();
                int half = (int)Math.Ceiling(sortedRooms.Count / 2.0);
                var topRooms = sortedRooms.Take(half).ToList();
                var bottomRooms = sortedRooms.Skip(half).ToList();

                int maxCount = Math.Max(topRooms.Count, bottomRooms.Count);
                int svgWidth = Math.Max(850, maxCount * 145 + 180);

                <div class="blueprint-card">
                    <div class="blueprint-title">
                        <span>📐</span> @floor.Key
                    </div>

                    <div class="svg-blueprint-wrapper">
                        <svg viewBox="0 0 @svgWidth 360" width="100%" height="330" style="display: block;">
                            <defs>
                                <pattern id="blueprint-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                                    <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#232732" stroke-width="1" />
                                </pattern>
                                <linearGradient id="corridor-grad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#16181D" />
                                    <stop offset="100%" stop-color="#121419" />
                                </linearGradient>
                            </defs>

                            <!-- 结构底纹网格 -->
                            <rect width="100%" height="100%" fill="url(#blueprint-grid)" />

                            <!-- 建筑外墙轮廓 -->
                            <rect x="40" y="20" width="@(svgWidth - 80)" height="320" rx="12" fill="#181a1f" stroke="#333845" stroke-width="3" />

                            <!-- 中央走廊通道 (Hallway) -->
                            <rect x="60" y="135" width="@(svgWidth - 120)" height="90" fill="url(#corridor-grad)" stroke="#3a404f" stroke-dasharray="8,8" stroke-width="2" />
                            <text x="@(svgWidth / 2)" y="178" fill="#50586b" font-size="11" font-weight="bold" text-anchor="middle" letter-spacing="4">CENTRAL HOTEL CORRIDOR / WALKWAY</text>

                            <!-- 电梯枢纽公共区 (Elevator Lobby - 灰蓝底色+图标突出) -->
                            <rect x="@(svgWidth / 2 - 55)" y="135" width="110" height="90" fill="#253245" stroke="#425B7A" stroke-width="2" rx="6" />
                            <text x="@(svgWidth / 2)" y="168" fill="#82A5C9" font-size="14" text-anchor="middle">🛗</text>
                            <text x="@(svgWidth / 2)" y="188" fill="#E2E8F0" font-size="11" font-weight="bold" text-anchor="middle">LOBBY & LIFT</text>
                            <text x="@(svgWidth / 2)" y="203" fill="#82A5C9" font-size="9" text-anchor="middle">Public Area</text>

                            <!-- 严格按顺序排列的上方房间 (North Wing) -->
                            @{
                                int startX = 70;
                                foreach (var room in topRooms)
                                {
                                    // 浅绿 / 浅橙柔和体系
                                    string fillCol = room.IsAvailable ? "#24362B" : "#402E24";
                                    string borderCol = room.IsAvailable ? "#3D7855" : "#855A38";
                                    string txtColor = room.IsAvailable ? "#5EEA8A" : "#FFA756";
                                    string detailsUrl = Url.Action("Details", "Catalog", new { id = room.ProductId });
                                    string clickJs = room.IsAvailable ? $"location.href='{detailsUrl}'" : "alert('This room is currently booked.');";

                                    <g class="svg-room" onclick="@clickJs">
                                        <rect x="@startX" y="35" width="130" height="90" rx="10" fill="@fillCol" stroke="@borderCol" stroke-width="2" />
                                        <!-- 门禁结构标记线 -->
                                        <line x1="@(startX + 50)" y1="125" x2="@(startX + 80)" y2="125" stroke="#606a7b" stroke-width="4" stroke-linecap="round" />

                                        <!-- 文字层级：房号最大加粗、房型次之完整显示、状态最小居中 -->
                                        <text x="@(startX + 65)" y="62" fill="#ffffff" font-size="15" font-weight="700" text-anchor="middle" letter-spacing="1">@room.ProductId</text>
                                        <text x="@(startX + 65)" y="81" fill="#9ca3af" font-size="11" font-weight="400" text-anchor="middle">@room.Name</text>

                                        <!-- 状态居中排版 -->
                                        <g transform="translate(@(startX + 65), 100)">
                                            <circle cx="-30" cy="-4" r="4" fill="@txtColor" />
                                            <text x="-20" y="0" fill="@txtColor" font-size="10" font-weight="600" text-anchor="start">@(room.IsAvailable ? "Available" : "Booked")</text>
                                        </g>
                                    </g>
                                    startX += 140;
                                }

                                // 严格按顺序排列的下方房间 (South Wing)
                                startX = 70;
                                foreach (var room in bottomRooms)
                                {
                                    string fillCol = room.IsAvailable ? "#24362B" : "#402E24";
                                    string borderCol = room.IsAvailable ? "#3D7855" : "#855A38";
                                    string txtColor = room.IsAvailable ? "#5EEA8A" : "#FFA756";
                                    string detailsUrl = Url.Action("Details", "Catalog", new { id = room.ProductId });
                                    string clickJs = room.IsAvailable ? $"location.href='{detailsUrl}'" : "alert('This room is currently booked.');";

                                    <g class="svg-room" onclick="@clickJs">
                                        <rect x="@startX" y="235" width="130" height="90" rx="10" fill="@fillCol" stroke="@borderCol" stroke-width="2" />
                                        <!-- 门禁结构标记线 -->
                                        <line x1="@(startX + 50)" y1="235" x2="@(startX + 80)" y2="235" stroke="#606a7b" stroke-width="4" stroke-linecap="round" />

                                        <!-- 文字层级：房号最大加粗、房型次之完整显示、状态最小居中 -->
                                        <text x="@(startX + 65)" y="262" fill="#ffffff" font-size="15" font-weight="700" text-anchor="middle" letter-spacing="1">@room.ProductId</text>
                                        <text x="@(startX + 65)" y="281" fill="#9ca3af" font-size="11" font-weight="400" text-anchor="middle">@room.Name</text>

                                        <!-- 状态居中排版 -->
                                        <g transform="translate(@(startX + 65), 300)">
                                            <circle cx="-30" cy="-4" r="4" fill="@txtColor" />
                                            <text x="-20" y="0" fill="@txtColor" font-size="10" font-weight="600" text-anchor="start">@(room.IsAvailable ? "Available" : "Booked")</text>
                                        </g>
                                    </g>
                                    startX += 140;
                                }
                            }
                        </svg>
                    </div>
                </div>
            }
        }
    </div>

</div>

<script>
    function switchView(viewType) {
        const gridContainer = document.getElementById('gridContainer');
        const mapViewContainer = document.getElementById('mapViewContainer');
        const btnGrid = document.getElementById('btnGrid');
        const btnMap = document.getElementById('btnMap');

        if (viewType === 'map') {
            gridContainer.style.display = 'none';
            mapViewContainer.style.display = 'block';
            btnMap.classList.add('active');
            btnGrid.classList.remove('active');
        } else {
            gridContainer.style.display = 'block';
            mapViewContainer.style.display = 'none';
            btnGrid.classList.add('active');
            btnMap.classList.remove('active');
        }
    }
</script>