@model AvailabilityVM

@{
    ViewData["Title"] = "Room Availability";

    var monthStart = new DateTime(Model.Year, Model.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);

    var previousMonth = monthStart.AddMonths(-1);
    var nextMonth = monthStart.AddMonths(1);
}

<style>
    .availability-page {
        min-height: calc(100vh - 70px);
        background: #f7f7fb;
        padding: 40px 4%;
    }

    .availability-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .availability-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .availability-header h1 {
            margin: 0;
            font-size: 30px;
            color: #202033;
        }

        .availability-header p {
            margin-top: 7px;
            color: #888;
            font-size: 14px;
        }

    .month-navigation {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .month-button {
        text-decoration: none;
        background: white;
        color: #655bd0;
        padding: 9px 15px;
        border-radius: 9px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        font-weight: 600;
    }

        .month-button:hover {
            background: #f0effd;
        }

    .month-title {
        min-width: 170px;
        text-align: center;
        font-size: 20px;
        font-weight: 700;
        color: #333;
    }

    .calendar-card {
        background: white;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        overflow-x: auto;
    }

    .calendar {
        min-width: 850px;
        border-collapse: collapse;
        width: 100%;
    }

        .calendar th {
            background: #f7f7fa;
            color: #666;
            font-size: 12px;
            padding: 10px 5px;
            border: 1px solid #eee;
        }

    .room-name {
        min-width: 135px;
        text-align: left;
        padding-left: 12px !important;
        color: #333 !important;
    }

        .room-name strong {
            display: block;
            font-size: 13px;
            color: #333;
        }

        .room-name span {
            display: block;
            margin-top: 3px;
            font-size: 11px;
            font-weight: 400;
            color: #888;
        }

    .calendar td {
        height: 38px;
        text-align: center;
        border: 1px solid #eee;
        font-size: 11px;
    }

    .available-day {
        background: #e8f8ef;
    }

    .occupied-day {
        background: #f6c5ca;
    }

    .legend {
        display: flex;
        gap: 20px;
        margin-top: 20px;
        font-size: 13px;
        color: #666;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .legend-box {
        width: 18px;
        height: 18px;
        border-radius: 5px;
    }

    .legend-available {
        background: #e8f8ef;
        border: 1px solid #b9e9cc;
    }

    .legend-occupied {
        background: #f9c9ce;
        border: 1px solid #ed9da5;
    }

    @@media (max-width: 800px) {
        .availability-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
        }
    }
</style>


<div class="availability-page">

    <div class="availability-container">

        <!-- Header -->

        <div class="availability-header">

            <div>
                <h1>Room Availability</h1>

                <p>
                    Check room availability before selecting your stay.
                </p>
            </div>


            <!-- Month Navigation -->

            <div class="month-navigation">

                <a asp-action="Availability"
                   asp-route-year="@previousMonth.Year"
                   asp-route-month="@previousMonth.Month"
                   class="month-button">
                    ←
                </a>

                <div class="month-title">
                    @monthStart.ToString("MMMM yyyy")
                </div>

                <a asp-action="Availability"
                   asp-route-year="@nextMonth.Year"
                   asp-route-month="@nextMonth.Month"
                   class="month-button">
                    →
                </a>

            </div>

        </div>


        <!-- Calendar -->

        <div class="calendar-card">

            <table class="calendar">

                <thead>

                    <tr>

                        <th class="room-name">
                            Room
                        </th>

                        @for (int day = 1; day <= daysInMonth; day++)
                        {
                            <th>
                                @day
                            </th>
                        }

                    </tr>

                </thead>


                <tbody>

                    @foreach (var product in Model.Products)
                    {
                        <tr>

                            <th class="room-name">

                                <strong>
                                    @product.ProductId
                                </strong>

                                <span>
                                    @product.Name
                                </span>

                            </th>


                            @for (int day = 1; day <= daysInMonth; day++)
                            {
                                var currentDate = new DateTime(Model.Year, Model.Month, day);

                                // Room is considered occupied if it has an overlapping booking OR if it's under maintenance/unavailable
                                var isBooked = Model.Bookings.Any(b =>
                                b.ProductId == product.ProductId &&
                                b.CheckInDate.Date <= currentDate &&
                                b.CheckOutDate.Date > currentDate);

                                var occupied = isBooked || product.IsMaintenance || !product.IsAvailable;

                                if (occupied)
                                {
                                    <td class="occupied-day"
                                        title="Occupied">
                                    </td>
                                }
                                else
                                {
                                    <td class="available-day"
                                        title="Available">
                                    </td>
                                }
                            }

                        </tr>
                    }

                </tbody>

            </table>


            <!-- Legend -->

            <div class="legend">

                <div class="legend-item">

                    <div class="legend-box legend-available"></div>

                    <span>
                        Available
                    </span>

                </div>


                <div class="legend-item">

                    <div class="legend-box legend-occupied"></div>

                    <span>
                        Occupied
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>