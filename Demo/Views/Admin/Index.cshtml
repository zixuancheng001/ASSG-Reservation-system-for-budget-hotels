@model IEnumerable<Demo.Models.Admin>

@{
    ViewBag.Title = "Admin Maintenance";
}

<div class="data-card">
    <div class="card-header-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h1>Admin Maintenance</h1>
        <a asp-action="Add" class="btn-add">+ Add New Admin</a>
    </div>

    <div style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
        <input type="text" id="searchInput" placeholder="Search by name or email..."
               style="flex: 2; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;"
               onkeyup="debouncedLoad()" />

        <select id="sortPicker" style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" onchange="loadAdmins(1)">
            <option value="name_asc">Name (A-Z)</option>
            <option value="name_desc">Name (Z-A)</option>
            <option value="email_asc">Email (A-Z)</option>
            <option value="email_desc">Email (Z-A)</option>
        </select>
    </div>

    <div style="width: 100%; overflow-x: auto;">
        <table class="custom-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="adminTableBody">
            </tbody>
        </table>
    </div>

    <div id="resultCount" style="margin-top: 10px; color: #6c757d; font-size: 13px;"></div>
    <div id="paginationContainer" style="text-align: center; margin-top: 15px;"></div>
</div>

@section scripts {
    <script>
        const currentAdminEmail = "@User.Identity!.Name";

        let searchDebounceTimer = null;

        document.addEventListener("DOMContentLoaded", function () {
            loadAdmins(1);
        });

        function debouncedLoad() {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => loadAdmins(1), 300);
        }

        function loadAdmins(page = 1) {
            const query = document.getElementById('searchInput').value;
            const sortBy = document.getElementById('sortPicker').value;

            const url = `/Admin/GetAdminsJson?query=${encodeURIComponent(query)}&sortBy=${encodeURIComponent(sortBy)}&page=${page}`;

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const items = data.items || data.Items || (Array.isArray(data) ? data : []);
                    const currentPage = data.currentPage || data.CurrentPage || page;
                    const totalPages = data.totalPages || data.TotalPages || 1;
                    const totalItems = data.totalItems || data.TotalItems || items.length;

                    renderTable(items, query);
                    renderPagination(currentPage, totalPages);
                    renderResultCount(totalItems);
                })
                .catch(error => console.error('Error fetching admins:', error));
        }

        function renderResultCount(totalItems) {
            const el = document.getElementById('resultCount');
            el.textContent = `${totalItems} admin${totalItems === 1 ? '' : 's'} found`;
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str ?? '';
            return div.innerHTML;
        }

        function escapeRegex(str) {
            return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        function highlight(text, query) {
            const safeText = escapeHtml(text);
            if (!query) return safeText;

            const safeQuery = escapeHtml(query);
            const regex = new RegExp(escapeRegex(safeQuery), 'gi');
            return safeText.replace(regex, match => `<mark class="search-highlight">${match}</mark>`);
        }

        function renderTable(admins, query) {
            const tbody = document.getElementById('adminTableBody');
            tbody.innerHTML = '';

            if (!admins || admins.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;">No admins found.</td></tr>';
                return;
            }

            admins.forEach(a => {
                const email = a.email || a.Email || '';
                const name = a.name || a.Name || '';
                const photoURL = a.photoURL || a.PhotoURL;
                const photoSrc = photoURL ? `/photos/${photoURL}` : '/images/photo.jpg';
                const isSelf = email.toLowerCase() === currentAdminEmail.toLowerCase();
                const deleteAction = isSelf
                    ? `<button type="button" class="btn-delete" disabled title="You cannot delete your own account.">Delete</button>`
                    : `<form action="/Admin/Delete/${encodeURIComponent(email)}" method="post" onsubmit="return confirm('Are you sure you want to delete this admin?');" style="display:inline;">
                            <button type="submit" class="btn-delete">Delete</button>
                       </form>`;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><img src="${photoSrc}" class="table-img" /></td>
                    <td><strong>${highlight(email, query)}</strong>${isSelf ? ' <span style="font-size:11px;color:#6c757d;">(you)</span>' : ''}</td>
                    <td>${highlight(name, query)}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/Admin/Edit/${encodeURIComponent(email)}" class="btn-edit">Edit</a>
                            ${deleteAction}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderPagination(currentPage, totalPages) {
            const container = document.getElementById('paginationContainer');
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            container.innerHTML = `
                <div style="display: inline-flex; gap: 8px; align-items: center;">
                    <button type="button" class="btn-page" ${currentPage === 1 ? 'disabled' : ''} onclick="loadAdmins(${currentPage - 1})">Previous</button>
                    <span>Page ${currentPage} of ${totalPages}</span>
                    <button type="button" class="btn-page" ${currentPage === totalPages ? 'disabled' : ''} onclick="loadAdmins(${currentPage + 1})">Next</button>
                </div>
            `;
        }
    </script>
}
