@model OrderVM

@{
    ViewBag.Title = "Edit Order";
}

<div class="auth-card" style="width: 440px;">
    <h1>Edit Order</h1>

    <form asp-action="Edit" method="post">
        <div class="validation-summary-errors" asp-validation-summary="ModelOnly"></div>

        <input type="hidden" asp-for="OrderId" />

        <label>Order ID</label>
        <input value="#@Model.OrderId" disabled />

        <label>Member</label>
        <input value="@Model.MemberEmail" disabled />

        <label>Order Date</label>
        <input value="@Model.OrderDate.ToString("dd MMM yyyy")" disabled />

        <label>Total Amount</label>
        <input value="RM @Model.TotalAmount.ToString("F2")" disabled />

        <label asp-for="Status">Status</label>
        <select asp-for="Status">
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        <span asp-validation-for="Status" class="field-validation-error"></span>

        <div class="btn-group">
            <button type="submit">Update Order</button>
            <a asp-action="Index" class="auth-links" style="margin-top:10px;">Back to List</a>
        </div>
    </form>
</div>
