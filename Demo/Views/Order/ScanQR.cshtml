@{
    ViewData["Title"] = "Scan QR Code";
}

<style>
    .qr-page-container {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .qr-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(101, 91, 208, 0.12);
        width: 100%;
        max-width: 500px;
        padding: 36px 30px;
        text-align: center;
    }

    .qr-header-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #7067d8, #a86fd3);
        color: white;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin: 0 auto 16px auto;
        box-shadow: 0 8px 18px rgba(112, 103, 216, 0.3);
    }

    /* Scanner Wrapper Setup */
    .scanner-wrapper {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        margin-bottom: 15px;
    }

    #reader {
        width: 100% !important;
        border: none !important;
    }

        /* Style the library's internal elements cleanly */
        #reader video {
            width: 100% !important;
            height: auto !important;
            border-radius: 12px;
            object-fit: cover;
        }

        #reader button {
            background: #7067d8 !important;
            color: white !important;
            border: none !important;
            padding: 10px 20px !important;
            border-radius: 10px !important;
            font-weight: 600 !important;
            font-size: 14px !important;
            cursor: pointer !important;
            margin: 10px 4px !important;
        }

            #reader button:hover {
                background: #5e54c8 !important;
            }

        #reader a {
            color: #7067d8 !important;
            font-weight: 600 !important;
            text-decoration: none !important;
            font-size: 13px !important;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #555;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 10px 22px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: 0.2s ease;
        margin-top: 15px;
    }

        .btn-back:hover {
            background: #f1f5f9;
            color: #202033;
        }
</style>

<div class="qr-page-container">
    <div class="qr-card">
        <div class="qr-header-icon">
            <i class="bi bi-qr-code-scan"></i>
        </div>
        <h2 class="qr-title">Scan Order QR Code</h2>
        <p class="qr-subtitle">Position the customer's QR code within the frame to check in.</p>

        <div class="scanner-wrapper">
            <div id="reader"></div>
        </div>

        <div id="scan-result" class="alert status-alert mt-3 d-none" role="alert"></div>

        @Html.AntiForgeryToken()

        <div>
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Back to Order List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script>
        let isProcessing = false;

        function onScanSuccess(decodedText) {
            if (isProcessing) return;
            isProcessing = true;

            const resultDiv = document.getElementById('scan-result');
            resultDiv.className = "alert alert-info status-alert mt-3";
            resultDiv.classList.remove('d-none');
            resultDiv.innerHTML = '<i class="bi bi-hourglass-split me-2"></i> Processing scanned code...';

            let orderId = decodedText.replace(/\D/g, '');

            if (!orderId) {
                resultDiv.className = "alert alert-danger status-alert mt-3";
                resultDiv.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i> Invalid QR code format. Could not find Order ID.';
                setTimeout(() => { isProcessing = false; }, 2000);
                return;
            }

            fetch('/Order/ProcessScan', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ orderId: parseInt(orderId) })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    resultDiv.className = "alert alert-success status-alert mt-3";
                    resultDiv.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i> ${data.message}`;

                    setTimeout(() => {
                        window.location.href = data.redirectUrl;
                    }, 1500);
                } else {
                    resultDiv.className = "alert alert-danger status-alert mt-3";
                    resultDiv.innerHTML = `<i class="bi bi-x-circle-fill me-2"></i> ${data.message}`;
                    setTimeout(() => { isProcessing = false; }, 3000);
                }
            })
            .catch(error => {
                resultDiv.className = "alert alert-danger status-alert mt-3";
                resultDiv.innerHTML = '<i class="bi bi-exclamation-circle-fill me-2"></i> Error processing request.';
                setTimeout(() => { isProcessing = false; }, 3000);
            });
        }

        let html5QrcodeScanner = new Html5QrcodeScanner(
            "reader",
            {
                fps: 10,
                qrbox: { width: 220, height: 220 },
                aspectRatio: 1.0
            },
            /* verbose= */ false
        );
        html5QrcodeScanner.render(onScanSuccess);
    </script>
}
