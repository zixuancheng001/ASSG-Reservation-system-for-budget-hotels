@model Demo.Models.Coupon

@{
    ViewBag.Title = "Create Coupon";
}

<style>
    main {
        align-items: flex-start !important;
        padding: 32px 4% !important;
    }
</style>

<div class="data-card" style="max-width: 520px;">
    <div class="card-header-bar" style="margin-bottom: 20px;">
        <h1>Create New Coupon</h1>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- Coupon Code -->
        <div class="form-group">
            <label asp-for="Code">Coupon Code</label>
            <input asp-for="Code" class="form-control" placeholder="e.g. SUMMER20" style="text-transform: uppercase;" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <!-- Discount % -->
        <div class="form-group">
            <label asp-for="DiscountPercent">Discount (%)</label>
            <input asp-for="DiscountPercent" type="number" step="0.01" min="0.01" max="100" class="form-control" placeholder="e.g. 10" />
            <span asp-validation-for="DiscountPercent" class="text-danger"></span>
        </div>

        <!-- Expiry Date (optional) -->
        <div class="form-group">
            <label asp-for="ExpiryDate">Expiry Date <span style="color:#888; font-weight:400;">(leave blank for no expiry)</span></label>
            <input type="date" name="ExpiryDate" class="form-control" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>

        <!-- Is Active -->
        <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
            <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px;" />
            <label asp-for="IsActive" style="margin: 0;">Active (usable by members)</label>
        </div>

        <div style="display: flex; gap: 10px;">
            <button type="submit" class="btn-action-gradient">Create Coupon</button>
            <a asp-action="Index" class="btn-edit">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
