@model IEnumerable<Demo.Models.Category>

@{
    ViewBag.Title = "Category Maintenance";
}

<!-- Hidden Anti-Forgery Token for JS Injection -->
<div id="csrfTokenContainer" style="display:none;">
    @Html.AntiForgeryToken()
</div>

<div class="data-card">
    <div class="card-header-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h1>Category Maintenance</h1>
        <a asp-action="Create" class="btn-action-gradient">+ Add New Category</a>
    </div>

    <!-- CONTROL BAR -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
        <input type="text" id="searchInput" placeholder="Search category name or ID..."
               style="flex: 2; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;"
               onkeyup="loadCategories(1)" />

        <select id="sortPicker" style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;" onchange="loadCategories(1)">
            <option value="name_asc">Name (A-Z)</option>
            <option value="name_desc">Name (Z-A)</option>
            <option value="id_asc">ID (Ascending)</option>
            <option value="id_desc">ID (Descending)</option>
        </select>
    </div>

    <!-- TABLE CONTAINER WITH SCROLL OVERFLOW PROTECTION -->
    <div style="width: 100%; overflow-x: auto;">
        <table class="custom-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th>Category ID</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Total Products</th>
                    <th>Featured</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="categoryTableBody">
                <!-- Rendered by JavaScript dynamically -->
            </tbody>
        </table>
    </div>

    <!-- PAGINATION CONTROLS -->
    <div id="paginationContainer" style="text-align: center; margin-top: 15px;"></div>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadCategories(1);
        });

        function loadCategories(page = 1) {
            const query = document.getElementById('searchInput').value;
            const sortBy = document.getElementById('sortPicker').value;

            const url = `/Category/GetCategoriesJson?query=${encodeURIComponent(query)}&sortBy=${encodeURIComponent(sortBy)}&page=${page}`;

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const items = data.items || data.Items || (Array.isArray(data) ? data : []);
                    const currentPage = data.currentPage || data.CurrentPage || page;
                    const totalPages = data.totalPages || data.TotalPages || 1;

                    renderTable(items);
                    renderPagination(currentPage, totalPages);
                })
                .catch(error => console.error('Error fetching categories:', error));
        }

        function renderTable(categories) {
            const tbody = document.getElementById('categoryTableBody');
            tbody.innerHTML = '';

            if (!categories || categories.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">No categories found.</td></tr>';
                return;
            }

            // Extract the raw anti-forgery token HTML string from the hidden container
            const tokenHtml = document.getElementById('csrfTokenContainer').innerHTML;

            categories.forEach(c => {
                const id = c.categoryId || c.CategoryId || '';
                const name = c.name || c.Name || '';
                const description = c.description || c.Description || '-';
                const productCount = c.productCount !== undefined ? c.productCount : (c.ProductCount !== undefined ? c.ProductCount : 0);
                const isFeatured = c.isFeatured !== undefined ? c.isFeatured : c.IsFeatured;

                // Featured Badge Design
                const featuredBadge = isFeatured
                    ? '<span class="badge-yes" style="background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; padding: 4px 8px; border-radius: 12px; font-weight: bold; font-size: 12px;">⭐ Featured</span>'
                    : '<span style="color: #6c757d; font-size: 13px;">Standard</span>';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${id}</strong></td>
                    <td>${name}</td>
                    <td>${description}</td>
                    <td>${productCount} Items</td>
                    <td>${featuredBadge}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/Category/Edit/${id}" class="btn-edit">Edit</a>
                            <form action="/Category/Delete/${id}" method="post" onsubmit="return confirm('Are you sure you want to delete this category?');" style="display:inline;">
                                ${tokenHtml}
                                <button type="submit" class="btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderPagination(currentPage, totalPages) {
            const container = document.getElementById('paginationContainer');
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            container.innerHTML = `
                <div style="display: inline-flex; gap: 8px; align-items: center;">
                    <button type="button" class="btn-action-gradient" ${currentPage === 1 ? 'disabled' : ''} onclick="loadCategories(${currentPage - 1})">Previous</button>
                    <span>Page ${currentPage} of ${totalPages}</span>
                    <button type="button" class="btn-action-gradient" ${currentPage === totalPages ? 'disabled' : ''} onclick="loadCategories(${currentPage + 1})">Next</button>
                </div>
            `;
        }
    </script>
}